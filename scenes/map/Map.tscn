code = "shader_type canvas_item;
uniform float offset: hint_range(0, 1) = 0.0;

void fragment(){
	vec2 uv = UV;
	uv.x += offset;
	uv.y += offset;
    uv.x = fract(uv.x);
	uv.y = fract(uv.y);
    COLOR = texture(TEXTURE, uv);
}"

